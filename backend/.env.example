PORT=3000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name
# true untuk database cloud yang wajib SSL, false untuk MySQL bawaan cPanel
MYSQL_SSL=true

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=3d

ACCESS_TOKEN_SECRET=access_secret_key_example
REFRESH_TOKEN_SECRET=refresh_secret_key_example

# URL frontend untuk CORS, tanpa "/" di akhir
CLIENT_URL_DEV=http://localhost:5173
CLIENT_URL_PROD=https://lostandfound.example.com

# Cloudinary (Dashboard → API Keys). Foto di-upload langsung dari browser ke Cloudinary.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
